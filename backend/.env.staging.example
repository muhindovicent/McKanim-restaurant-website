# DineSight — McKanim staging configuration template.
# Copy these values into the Render service environment dashboard, not source control.
# This file contains no credentials and must never be used as a live .env file.
NODE_ENV=production
APP_ENV=staging
# Render supplies PORT at runtime; don't override it unnecessarily.
PUBLIC_WEB_ORIGIN=https://mckanim-dinesight-preview.onrender.com
CORS_ORIGINS=https://mckanim-dinesight-preview.onrender.com
INVITATION_DELIVERY_MODE=disabled
# DATABASE_URL must be set privately to a SEPARATE Neon staging PostgreSQL database.
# Do not commit or paste a real password/connection string into GitHub or chat.
