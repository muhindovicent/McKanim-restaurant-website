# Development defaults only. Never commit live credentials.
NODE_ENV=development
APP_ENV=development
PORT=3001
DATABASE_URL=postgresql://dinesight_user:local_password@localhost:5432/dinesight?schema=public
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
INVITATION_DELIVERY_MODE=disabled

# After creating a real staging deployment in the hosting dashboard, set:
# NODE_ENV=production
# APP_ENV=staging
# CORS_ORIGINS=https://YOUR-ACTUAL-VERCEL-PREVIEW-HOST.vercel.app
# PUBLIC_WEB_ORIGIN=https://YOUR-ACTUAL-VERCEL-PREVIEW-HOST.vercel.app
# DATABASE_URL=<private staging PostgreSQL connection URL>
# Do NOT use a guessed frontend hostname or enable email sending.
