{
  "name": "@dinesight/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "DineSight commercial restaurant API foundation — early development; not yet production ready",
  "engines": {
    "node": ">=22.22.3"
  },
  "scripts": {
    "dev": "node --env-file=.env --import tsx src/main.ts",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run db:validate && npm run build && npm test"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "helmet": "^8.0.0",
    "pg": "^8.13.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "prisma": "7.10.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
